+const OFFLINE_SAVE_KEYS = [
+  "data",
+  "sessionData",
+  "sessionData1",
+  "sessionData2",
+  "sessionData3",
+  "sessionData4",
+  "runHistoryData",
+];
+
+/** The name to play under offline: `offlineUsername` from localStorage if valid, else "Guest". */
+function getOfflineUsername(): string {
+  try {
+    const name = (localStorage.getItem("offlineUsername") ?? "").trim();
+    return /^[A-Za-z0-9_-]{1,32}$/.test(name) ? name : "Guest";
+  } catch {
+    return "Guest";
+  }
+}
+
+/** When the offline name changes, moves each save from the previous name to the new one (never overwriting). */
+function migrateOfflineSave(name: string): void {
+  try {
+    const previous = localStorage.getItem("offlineUsernameActive") || "Guest";
+    if (previous !== name) {
+      for (const key of OFFLINE_SAVE_KEYS) {
+        const from = localStorage.getItem(`${key}_${previous}`);
+        if (from && !localStorage.getItem(`${key}_${name}`)) {
+          localStorage.setItem(`${key}_${name}`, from);
+          localStorage.removeItem(`${key}_${previous}`);
+        }
+      }
+    }
+    localStorage.setItem("offlineUsernameActive", name);
+  } catch {
+    // Storage unavailable: play as is.
+  }
+}
